ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...
SEMANTIC_SCHOLAR_API_KEY=
TAMARIND_API_KEY=...
# Optional: disable heavy Tavily→RAG startup indexing by default on small instances.
# Set true only when you explicitly want one-time indexing at boot.
TAVILY_RAG_STARTUP_INDEX=false
# Optional: cap AlphaFold polling in the pipeline (seconds). Default 1800.
# TAMARIND_POLL_MAX_SECONDS=1800
# Optional: max Tamarind jobs persisted via local cache counter. Default 10.
# TAMARIND_MAX_JOBS_PER_CACHE=10
DEMO_MODE=false
PORT=8000
